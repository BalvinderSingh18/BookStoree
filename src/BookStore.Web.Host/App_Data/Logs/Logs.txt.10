SELECT [s].[Id], [s].[Address], [s].[CityId], [s].[CountryId], [s].[CourseId], [s].[Dob], [s].[Gender], [s].[Name], [s].[StateId], [c].[Id], [c].[Description], [c].[Name], [c0].[Id], [c0].[Name], [s0].[Id], [s0].[CountryId], [s0].[Name], [c1].[Id], [c1].[Name], [c1].[StateId]
FROM [Students] AS [s]
INNER JOIN [Courses] AS [c] ON [s].[CourseId] = [c].[Id]
INNER JOIN [Countries] AS [c0] ON [s].[CountryId] = [c0].[Id]
INNER JOIN [States] AS [s0] ON [s].[StateId] = [s0].[Id]
INNER JOIN [Cities] AS [c1] ON [s].[CityId] = [c1].[Id]
ORDER BY [s].[Name]
